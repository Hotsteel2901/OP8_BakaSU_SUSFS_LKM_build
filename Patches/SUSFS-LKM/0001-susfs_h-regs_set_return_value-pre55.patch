+/* regs_set_return_value() is per-arch and only appeared in 5.5; arm64 4.19 has no such
+ * helper (arch/arm64/include/asm/syscall.h defines only syscall_get/set_return_value).
+ * It is used by sus_map / sus_path / susfs_hide_syms, all of which include this header. */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 5, 0) && defined(CONFIG_ARM64)
+static inline void regs_set_return_value(struct pt_regs *regs, unsigned long val)
+{
+	regs->regs[0] = val;
+}
+#endif
