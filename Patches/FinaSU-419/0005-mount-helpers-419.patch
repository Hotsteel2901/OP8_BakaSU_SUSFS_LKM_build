@@ -28,6 +29,31 @@
 extern int path_mount(const char *dev_name, struct path *path, const char *type_page, unsigned long flags,
                       void *data_page);
 
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 9, 0)
+/* path_mount() is a 5.9+ kernel-internal helper.  4.19 only has do_mount(),
+ * which takes a user-space path, so resolve the struct path to a string and
+ * pass it with KERNEL_DS.  This mirrors the fallback used by BakaSU/KernelSU
+ * for non-GKI 4.19. */
+__weak int path_mount(const char *dev_name, struct path *path, const char *type_page, unsigned long flags,
+                      void *data_page)
+{
+    char buf[384];
+    char *realpath;
+    mm_segment_t old_fs;
+    long ret;
+
+    realpath = d_path(path, buf, sizeof(buf) - 1);
+    if (IS_ERR(realpath) || realpath == buf)
+        return -ENOENT;
+
+    old_fs = get_fs();
+    set_fs(KERNEL_DS);
+    ret = do_mount(dev_name, (const char __user *)realpath, type_page, flags, data_page);
+    set_fs(old_fs);
+    return ret;
+}
+#endif
