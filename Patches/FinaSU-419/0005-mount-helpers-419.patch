 extern int path_umount(struct path *path, int flags);
 
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 9, 0)
+/* path_umount() is a 5.9+ kernel-internal helper.  4.19 has ksys_umount(),
+ * which takes a user-space path; resolve struct path + KERNEL_DS. */
+__weak int path_umount(struct path *path, int flags)
+{
+    char buf[256];
+    char *usermnt;
+    mm_segment_t old_fs;
+    int ret = -ENOENT;
+
+    usermnt = d_path(path, buf, sizeof(buf) - 1);
+    if (!IS_ERR(usermnt) && usermnt != buf) {
+        old_fs = get_fs();
+        set_fs(KERNEL_DS);
+        ret = ksys_umount((char __user *)usermnt, flags);
+        set_fs(old_fs);
+    }
+
+    path_put(path);
+    return ret;
+}
+#endif
